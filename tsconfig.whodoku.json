{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "types": ["vite/client", "node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "allowImportingTsExtensions": true
    },
    "include": ["resources/whodoku/js/**/*.ts", "resources/whodoku/js/**/*.vue", "vite.config.js", "vitest.whodoku.config.ts"]
}
