# --- ОБЩИЕ ---
APP_NAME=SelfBio
APP_DISPLAY_TIMEZONE=Europe/Moscow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
PLATFORM_PREFIX=admin
# Пути внутри контейнера SelfBio; доступны только после входа.
REPAIR_ROOT=/var/www/html/storage/app/private/repair-data/repair
REPAIR_ARCHIVE_ROOT=/var/www/html/storage/app/private/repair-data/archive

# --- ЛОКАЛИЗАЦИЯ ---
APP_LOCALE=ru
VITE_APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- ОБСЛУЖИВАНИЕ ---
APP_MAINTENANCE_DRIVER=file

# --- ХЕШИРОВАНИЕ ---
BCRYPT_ROUNDS=12

# --- ЛОГИРОВАНИЕ ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- БД ---
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# --- СЕССИИ ---
SESSION_DRIVER=redis
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOGIN_MAX_AGE=86400
TELEGRAM_DEV_LOGIN=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

# --- ОЧЕРЕДИ ---
QUEUE_CONNECTION=redis

# --- КЭШ ---
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- ПОЧТА ---
# Production: MAIL_MAILER=resend, RESEND_KEY from resend.com and MAIL_FROM_ADDRESS on the verified domain (check: php artisan mail:check you@example.com).
MAIL_MAILER=smtp
RESEND_KEY=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=localhost
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@local.test"

# --- VITE ---
VITE_APP_NAME="${APP_NAME}"

# --- CACHE ---
CONFIG_CACHE=true
ROUTE_CACHE=true
VIEW_CACHE=true

# --- DOCKER ---
# Локально: общий файл + docker-compose.local.yml (mailpit, xdebug, порты БД и Redis на хосте).
# На проде: COMPOSE_FILE=docker-compose.yml и PHP_TARGET=prod.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
PHP_TARGET=local
# id владельца файлов проекта на хосте (id -u / id -g): с ними php-fpm пишет в storage.
PUID=1000
PGID=1000
# Nginx контейнера: адрес и порт на хосте.
APP_BIND=127.0.0.1
APP_PORT=8080
XDEBUG_MODE=off

# --- ПОРТЫ ДЛЯ ПРОКИДКИ (локально) ---
FORWARD_REDIS_PORT=6379
FORWARD_DB_PORT=5432
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
VITE_PORT=5173
